<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="dialect">
  <schema id="@app-id@" path="/app/drey/Dialect/">
    <key type="ai" name="window-size">
        <default>[800, 300]</default>
    </key>
    <key type="s" name="color-scheme">
      <choices>
        <choice value="auto"/>
        <choice value="light"/>
        <choice value="dark"/>
      </choices>
      <default>"auto"</default>
    </key>
    <key type="b" name="live-translation">
        <default>false</default>
    </key>
    <key type="b" name="sp-translation">
      <default>false</default>
    </key>
    <key type="b" name="show-pronunciation">
        <default>false</default>
    </key>
    <key type="b" name="src-auto">
        <default>true</default>
    </key>
    <key type="b" name="ollama-preload-on-startup">
        <default>true</default>
        <summary>Preload Ollama model on startup</summary>
        <description>Begin loading the configured Ollama model in the background as soon as Dialect starts.</description>
    </key>
    <key type="b" name="ollama-keep-loaded">
        <default>true</default>
        <summary>Keep Ollama model loaded while Dialect is open</summary>
        <description>Use an infinite Ollama keep-alive while Dialect is running to avoid repeated cold starts.</description>
    </key>
    <key type="b" name="ollama-unload-on-exit">
        <default>true</default>
        <summary>Unload Ollama model on exit</summary>
        <description>Release the configured Ollama model from memory when Dialect exits.</description>
    </key>
    <key type="i" name="translate-accel">
        <!-- 0 = Ctrl+Enter | 1 = Enter -->
        <default>0</default>
    </key>
    <key type="b" name="custom-default-font-size">
        <default>false</default>
    </key>
    <key type="i" name="default-font-size">
        <!-- 0 = User has never enabled custom default font size before -->
        <default>0</default>
    </key>

    <child name="tts" schema="@app-id@.TTSList" />
    <child name="translators" schema="@app-id@.TranslatorsList" />
  </schema>

  <!-- Settings list schema -->
  <schema id="@app-id@.SettingsList">
    <key name="list" type="as">
      <default>[]</default>
    </key>
    <key name="active" type="s">
      <default>""</default>
    </key>
  </schema>

  <!-- Translators list schema -->
  <schema id="@app-id@.TranslatorsList" extends="@app-id@.SettingsList">
    <override name="active">"google"</override>
  </schema>

  <!-- Translator schema -->
  <schema id="@app-id@.translator">
    <key type="b" name="init">
        <default>false</default>
    </key>
    <key type="as" name="src-langs">
        <default>[]</default>
    </key>
    <key type="as" name="dest-langs">
        <default>[]</default>
    </key>
    <key type="s" name="instance-url">
        <default>""</default>
    </key>
    <key type="s" name="api-key">
        <default>""</default>
    </key>
    <key type="s" name="model">
        <default>""</default>
    </key>
    <key type="b" name="thinking">
        <default>false</default>
        <summary>Enable model thinking</summary>
        <description>Allow providers that support reasoning controls to use thinking mode.</description>
    </key>
  </schema>

  <!-- TTS list schema -->
  <schema id="@app-id@.TTSList" extends="@app-id@.SettingsList">
    <override name="active">"google"</override>
  </schema>
</schemalist>
